generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MatchType {
  LUNCH
  DINNER
}

enum HeroRole {
  MAIN_TANK
  OFFLANER
  MAIN_DEALER
  SUB_DEALER
  HEALER
}

model Player {
  id       Int     @id @default(autoincrement())
  nickname String  @unique
  name     String
  isActive Boolean @default(true)

  // relations
  matchTeamsLed    MatchTeam[]       @relation("MatchTeamLeader")
  matchTeamMembers MatchTeamMember[]
  gameStats        GamePlayerStats[]
}

model Hero {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  role     HeroRole?
  isActive Boolean   @default(true)

  gameStats GamePlayerStats[]
}

model Match {
  id         Int       @id @default(autoincrement())
  date       String
  matchType  MatchType
  gameCount  Int // 점심 3, 저녁 5
  team1Score Int       @default(0)
  team2Score Int       @default(0)

  // relations
  teams MatchTeam[]
  games Game[]

  @@index([matchType, date(sort: Desc)])
}

model MatchTeam {
  matchId  Int
  teamNo   Int
  leaderId Int

  match   Match             @relation(fields: [matchId], references: [id])
  leader  Player            @relation("MatchTeamLeader", fields: [leaderId], references: [id])
  members MatchTeamMember[]

  @@id([matchId, teamNo])
}

model MatchTeamMember {
  matchId  Int
  teamNo   Int
  playerId Int

  matchTeam MatchTeam @relation(fields: [matchId, teamNo], references: [matchId, teamNo])
  player    Player    @relation(fields: [playerId], references: [id])

  @@id([matchId, teamNo, playerId])
}

model Game {
  id      Int @id @default(autoincrement())
  matchId Int
  gameNo  Int // 1세트, 2세트...

  mapName String

  isDraw       Boolean @default(false)
  winnerTeamNo Int?

  match       Match             @relation(fields: [matchId], references: [id])
  playerStats GamePlayerStats[]

  @@unique([matchId, gameNo])
  @@index([matchId])
}

model GamePlayerStats {
  gameId   Int
  playerId Int
  teamNo   Int
  heroId   Int

  isWin Boolean

  kills       Int?
  deaths      Int?
  takedowns   Int?
  damageDone  Int?
  damageTaken Int?
  note        String

  game   Game   @relation(fields: [gameId], references: [id])
  player Player @relation(fields: [playerId], references: [id])
  hero   Hero   @relation(fields: [heroId], references: [id])

  @@id([gameId, playerId])
  @@index([playerId])
  @@index([heroId])
  @@index([playerId, heroId])
}
